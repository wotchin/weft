{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "version": "3.1.0",
    "version_name": "3.1.0-beta",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "contextMenus",
        "notifications",
        "tabs",
        "scripting",
        "sidePanel"
    ],
    "side_panel": {
        "default_path": "chat.html?mode=panel"
    },
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "assets/icon-16.png",
        "32": "assets/icon-32.png",
        "48": "assets/icon-48.png",
        "128": "assets/icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon-16.png",
            "32": "assets/icon-32.png",
            "48": "assets/icon-48.png",
            "128": "assets/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content-assist.js"],
            "run_at": "document_idle"
        }
    ],
    "options_page": "settings.html",
    "sandbox": {
        "pages": ["sandbox-mermaid.html"]
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:",
        "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; object-src 'none'; frame-src 'none'; media-src 'none'; font-src 'none'; base-uri 'none'; form-action 'none'"
    }
}
