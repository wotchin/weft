{
    "manifest_version": 3,
    "name": "Cyber Assistant",
    "description": "Collect web snippets and generate AI-powered reports, summaries, and insights.",
    "version": "2.0",
    "permissions": [
        "storage",
        "contextMenus",
        "notifications",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon.png",
            "48": "assets/icon.png",
            "128": "assets/icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content-assist.js"],
            "run_at": "document_idle"
        }
    ],
    "options_page": "settings.html",
    "sandbox": {
        "pages": ["sandbox-mermaid.html"]
    }
}
